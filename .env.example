# GitHub SDK (server-side only — never prefix with NEXT_PUBLIC_)
# Required: GitHub Personal Access Token (classic or fine-grained)
# Required scopes: read:user, public_repo
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub GraphQL API endpoint (optional — defaults to api.github.com/graphql)
# Override only if using GitHub Enterprise with a custom GraphQL endpoint.
# NEXT_PUBLIC_GITHUB_GRAPHQL=https://api.github.com/graphql